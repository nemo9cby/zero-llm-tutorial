(module
  (memory (export "mem") 1)
  ;; Horizontal sum of the four lanes: (l0 + l1) + (l2 + l3).
  (func $hsum (param $v v128) (result f32)
    (f32.add (f32.add (f32x4.extract_lane 0 (local.get $v)) (f32x4.extract_lane 1 (local.get $v)))
             (f32.add (f32x4.extract_lane 2 (local.get $v)) (f32x4.extract_lane 3 (local.get $v)))))
  ;; y[o] = sum_i W[o*nIn + i] * x[i]   (byte offsets; nIn % 4 == 0; any nOut)
  ;; Four output rows at a time; each output keeps one f32x4 accumulator, so its sum is formed in exactly
  ;; the same order as in $matmul below (prefill and decode give bit-identical results).
  (func (export "matvec") (param $W i32) (param $x i32) (param $y i32) (param $nIn i32) (param $nOut i32)
    (local $o i32) (local $o4 i32) (local $k i32) (local $rb i32)
    (local $w0 i32) (local $w1 i32) (local $w2 i32) (local $w3 i32) (local $yo i32)
    (local $a v128) (local $c0 v128) (local $c1 v128) (local $c2 v128) (local $c3 v128)
    (local.set $rb (i32.shl (local.get $nIn) (i32.const 2)))
    (local.set $o4 (i32.and (local.get $nOut) (i32.const -4)))
    (block $done (loop $lo
      (br_if $done (i32.ge_u (local.get $o) (local.get $o4)))
      (local.set $w0 (i32.add (local.get $W) (i32.mul (local.get $o) (local.get $rb))))
      (local.set $w1 (i32.add (local.get $w0) (local.get $rb)))
      (local.set $w2 (i32.add (local.get $w1) (local.get $rb)))
      (local.set $w3 (i32.add (local.get $w2) (local.get $rb)))
      (local.set $c0 (v128.const i32x4 0 0 0 0))
      (local.set $c1 (v128.const i32x4 0 0 0 0))
      (local.set $c2 (v128.const i32x4 0 0 0 0))
      (local.set $c3 (v128.const i32x4 0 0 0 0))
      (local.set $k (i32.const 0))
      (block $kd (loop $kl
        (br_if $kd (i32.ge_u (local.get $k) (local.get $rb)))
        (local.set $a (v128.load (i32.add (local.get $x) (local.get $k))))
        (local.set $c0 (f32x4.add (local.get $c0) (f32x4.mul (local.get $a) (v128.load (i32.add (local.get $w0) (local.get $k))))))
        (local.set $c1 (f32x4.add (local.get $c1) (f32x4.mul (local.get $a) (v128.load (i32.add (local.get $w1) (local.get $k))))))
        (local.set $c2 (f32x4.add (local.get $c2) (f32x4.mul (local.get $a) (v128.load (i32.add (local.get $w2) (local.get $k))))))
        (local.set $c3 (f32x4.add (local.get $c3) (f32x4.mul (local.get $a) (v128.load (i32.add (local.get $w3) (local.get $k))))))
        (local.set $k (i32.add (local.get $k) (i32.const 16)))
        (br $kl)))
      (local.set $yo (i32.add (local.get $y) (i32.shl (local.get $o) (i32.const 2))))
      (f32.store offset=0 (local.get $yo) (call $hsum (local.get $c0)))
      (f32.store offset=4 (local.get $yo) (call $hsum (local.get $c1)))
      (f32.store offset=8 (local.get $yo) (call $hsum (local.get $c2)))
      (f32.store offset=12 (local.get $yo) (call $hsum (local.get $c3)))
      (local.set $o (i32.add (local.get $o) (i32.const 4)))
      (br $lo)))
    (block $tdone (loop $tl
      (br_if $tdone (i32.ge_u (local.get $o) (local.get $nOut)))
      (local.set $w0 (i32.add (local.get $W) (i32.mul (local.get $o) (local.get $rb))))
      (local.set $c0 (v128.const i32x4 0 0 0 0))
      (local.set $k (i32.const 0))
      (block $kd2 (loop $kl2
        (br_if $kd2 (i32.ge_u (local.get $k) (local.get $rb)))
        (local.set $c0 (f32x4.add (local.get $c0) (f32x4.mul (v128.load (i32.add (local.get $x) (local.get $k)))
                                                             (v128.load (i32.add (local.get $w0) (local.get $k))))))
        (local.set $k (i32.add (local.get $k) (i32.const 16)))
        (br $kl2)))
      (f32.store (i32.add (local.get $y) (i32.shl (local.get $o) (i32.const 2))) (call $hsum (local.get $c0)))
      (local.set $o (i32.add (local.get $o) (i32.const 1)))
      (br $tl))))
  ;; Y[t*nOut + o] = sum_i X[t*nIn + i] * W[o*nIn + i]   (byte offsets; n % 4 == 0, nOut % 2 == 0, nIn % 4 == 0)
  ;; A 4 x 2 block of Y per pass: every row of W that is loaded serves four tokens.
  (func (export "matmul") (param $X i32) (param $W i32) (param $Y i32) (param $n i32) (param $nIn i32) (param $nOut i32)
    (local $t i32) (local $o i32) (local $k i32) (local $rb i32) (local $yb i32)
    (local $x0 i32) (local $x1 i32) (local $x2 i32) (local $x3 i32) (local $w0 i32) (local $w1 i32) (local $yo i32)
    (local $u v128) (local $v v128) (local $a v128)
    (local $c00 v128) (local $c01 v128) (local $c10 v128) (local $c11 v128)
    (local $c20 v128) (local $c21 v128) (local $c30 v128) (local $c31 v128)
    (local.set $rb (i32.shl (local.get $nIn) (i32.const 2)))
    (local.set $yb (i32.shl (local.get $nOut) (i32.const 2)))
    (block $tdone (loop $tloop
      (br_if $tdone (i32.ge_u (local.get $t) (local.get $n)))
      (local.set $x0 (i32.add (local.get $X) (i32.mul (local.get $t) (local.get $rb))))
      (local.set $x1 (i32.add (local.get $x0) (local.get $rb)))
      (local.set $x2 (i32.add (local.get $x1) (local.get $rb)))
      (local.set $x3 (i32.add (local.get $x2) (local.get $rb)))
      (local.set $o (i32.const 0))
      (block $odone (loop $oloop
        (br_if $odone (i32.ge_u (local.get $o) (local.get $nOut)))
        (local.set $w0 (i32.add (local.get $W) (i32.mul (local.get $o) (local.get $rb))))
        (local.set $w1 (i32.add (local.get $w0) (local.get $rb)))
        (local.set $c00 (v128.const i32x4 0 0 0 0)) (local.set $c01 (v128.const i32x4 0 0 0 0))
        (local.set $c10 (v128.const i32x4 0 0 0 0)) (local.set $c11 (v128.const i32x4 0 0 0 0))
        (local.set $c20 (v128.const i32x4 0 0 0 0)) (local.set $c21 (v128.const i32x4 0 0 0 0))
        (local.set $c30 (v128.const i32x4 0 0 0 0)) (local.set $c31 (v128.const i32x4 0 0 0 0))
        (local.set $k (i32.const 0))
        (block $kdone (loop $kloop
          (br_if $kdone (i32.ge_u (local.get $k) (local.get $rb)))
          (local.set $u (v128.load (i32.add (local.get $w0) (local.get $k))))
          (local.set $v (v128.load (i32.add (local.get $w1) (local.get $k))))
          (local.set $a (v128.load (i32.add (local.get $x0) (local.get $k))))
          (local.set $c00 (f32x4.add (local.get $c00) (f32x4.mul (local.get $a) (local.get $u))))
          (local.set $c01 (f32x4.add (local.get $c01) (f32x4.mul (local.get $a) (local.get $v))))
          (local.set $a (v128.load (i32.add (local.get $x1) (local.get $k))))
          (local.set $c10 (f32x4.add (local.get $c10) (f32x4.mul (local.get $a) (local.get $u))))
          (local.set $c11 (f32x4.add (local.get $c11) (f32x4.mul (local.get $a) (local.get $v))))
          (local.set $a (v128.load (i32.add (local.get $x2) (local.get $k))))
          (local.set $c20 (f32x4.add (local.get $c20) (f32x4.mul (local.get $a) (local.get $u))))
          (local.set $c21 (f32x4.add (local.get $c21) (f32x4.mul (local.get $a) (local.get $v))))
          (local.set $a (v128.load (i32.add (local.get $x3) (local.get $k))))
          (local.set $c30 (f32x4.add (local.get $c30) (f32x4.mul (local.get $a) (local.get $u))))
          (local.set $c31 (f32x4.add (local.get $c31) (f32x4.mul (local.get $a) (local.get $v))))
          (local.set $k (i32.add (local.get $k) (i32.const 16)))
          (br $kloop)))
        (local.set $yo (i32.add (local.get $Y) (i32.add (i32.mul (local.get $t) (local.get $yb)) (i32.shl (local.get $o) (i32.const 2)))))
        (f32.store offset=0 (local.get $yo) (call $hsum (local.get $c00)))
        (f32.store offset=4 (local.get $yo) (call $hsum (local.get $c01)))
        (local.set $yo (i32.add (local.get $yo) (local.get $yb)))
        (f32.store offset=0 (local.get $yo) (call $hsum (local.get $c10)))
        (f32.store offset=4 (local.get $yo) (call $hsum (local.get $c11)))
        (local.set $yo (i32.add (local.get $yo) (local.get $yb)))
        (f32.store offset=0 (local.get $yo) (call $hsum (local.get $c20)))
        (f32.store offset=4 (local.get $yo) (call $hsum (local.get $c21)))
        (local.set $yo (i32.add (local.get $yo) (local.get $yb)))
        (f32.store offset=0 (local.get $yo) (call $hsum (local.get $c30)))
        (f32.store offset=4 (local.get $yo) (call $hsum (local.get $c31)))
        (local.set $o (i32.add (local.get $o) (i32.const 2)))
        (br $oloop)))
      (local.set $t (i32.add (local.get $t) (i32.const 4)))
      (br $tloop)))))
